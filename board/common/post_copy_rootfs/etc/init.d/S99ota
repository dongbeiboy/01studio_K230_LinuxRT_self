#! /bin/sh
#
# S99ota - Start SWUpdate web server on boot (if network is available)
# To enable: touch /etc/ota_auto_start
#

SWUPDATE_BIN="/usr/bin/swupdate"

case "$1" in
    start)
        if [ -f /etc/ota_auto_start ]; then
            echo "Waiting for network..."
            for i in $(seq 1 15); do
                if ip route get 1 2>/dev/null | grep -q "via"; then
                    break
                fi
                sleep 2
            done
            echo "Starting SWUpdate OTA server..."
            mkdir -p /var/www/swupdate
            # -k 必需（签名强制）；mongoose 参数为 -w 后单个字符串，不支持 --listening-address
            # -p reboot: postupdate 命令，否则网页 Restart 按钮只执行空命令、不会重启
            ${SWUPDATE_BIN} -v \
                -k "${OTA_PUBKEY:-/etc/ota_public.pem}" \
                -p "${OTA_POSTUPDATE:-reboot}" \
                -w "--document-root /var/www/swupdate --port 9090" \
                > /var/log/swupdate.log 2>&1 &
        fi
        ;;
    stop)
        killall swupdate 2>/dev/null
        ;;
    restart)
        $0 stop; sleep 1; $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        ;;
esac
