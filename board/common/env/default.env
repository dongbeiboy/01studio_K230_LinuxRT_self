arch=riscv
autoload=0
baudrate=115200
board=k230_evb
board_name=k230_evb
bootdelay=5
cpu=k230

# === A/B 升级: 主启动命令 ===
# bootcmd_slot 根据 boot_slot 选择 root= p1(A) 或 p2(B)
bootcmd=run bootcmd_slot

bootcmd_slot=if test "${boot_slot}" = "b"; then setenv bootargs root=/dev/mmcblk0p2 loglevel=4 rw rootdelay=4 rootfstype=ext4 console=tty0 console=ttyS0,115200 crashkernel=256M-:128M earlycon=sbi; else setenv bootargs root=/dev/mmcblk0p1 loglevel=4 rw rootdelay=4 rootfstype=ext4 console=tty0 console=ttyS0,115200 crashkernel=256M-:128M earlycon=sbi; fi; k230_boot auto auto_boot

# bootcmd_rescue: 强制 Slot A + rescue 模式（A 损坏 → 唯一出路是重烧 SD）
# bootcmd_rescue: 强制 Slot A + 重置 attempt（防死循环）
bootcmd_rescue=setenv boot_slot a; setenv boot_slot_a_attempt 3; setenv boot_slot_b_attempt 3; setenv bootargs root=/dev/mmcblk0p1 rw rootfstype=ext4 console=ttyS0,115200 rescue; k230_boot auto auto_boot

# === A/B attempt 计数 ===
boot_attempt_max=3
boot_slot_a_attempt=3
boot_slot_b_attempt=3

# === 网络相关 ===
console_port=console=ttyS1,115200
dtb_addr=0x32000000
fdt_high=0x32100000
gatewayip=10.99.105.254
ipaddr=10.99.105.44
kernel_addr=0x34100000
loadaddr=0xc000000
mmc_boot_dev_num=0
netmask=255.255.255.0
ramdisk_addr=0x32100000
serverip=10.10.1.94

# === baremetal 启动（保留） ===
bootcmd_baremetal=mmc dev 1; mmc read 0 0x5000 0xa000; boot_baremetal 1 0 1400000
bootcmd_usb=run usb_load; bootm $kernel_addr - $dtb_addr

usb_load=usb start; dhcp; tftp $ramdisk_addr jiangxiangbing/rtt_system.bin; k230_boot mem $ramdisk_addr 0x$filesize; tftp $kernel_addr jiangxiangbing/fw_payload.img; tftp $ramdisk_addr jiangxiangbing/rootfs-final.cpio.gz; tftp $dtb_addr jiangxiangbing/k230.dtb

# === 系统升级（保留旧命令兼容） ===
upsdimg=usb start; dhcp; tftp 0x9000000 10.10.1.94:wjx/sysimage-sdcard.img.gz; gzwrite mmc 1 0x$fileaddr 0x$filesize
upsduboot=usb start; dhcp; tftp 0xc100000 10.10.1.94:wjx/u-boot.img && mmc dev 1; mmc write 0x$fileaddr 0x1000 0xc00
upspiimg=usb start; dhcp; tftp 0x9000000 10.10.1.94:wjx/sysimage-spinor32m.img; sf probe 0:0; sf erase 0 0x2000000; sf write 0x$fileaddr 0 0x$filesize; sf remove
upspiuboot=usb start; dhcp; tftp 0xc100000 10.10.1.94:wjx/u-boot.img && sf probe 0:0; sf erase 0x80000 0x180000; sf update 0x$fileaddr 0x80000 0x$filesize; sf remove

vendor=canaan
cdloadadd=0x10000000
quick_boot=false
